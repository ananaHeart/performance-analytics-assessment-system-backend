          },
          "status": {
            "enum": [
              "success",
              "failed"
            ]
          },
          "disposition": {
            "enum": [
              "created",
              "replayed",
              "rejected"
            ]
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
