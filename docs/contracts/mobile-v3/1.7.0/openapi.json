{
  "openapi": "3.1.0",
  "info": {
    "title": "SMART Mobile V3 written teacher verification",
    "version": "1.7.0"
  },
  "paths": {
    "/api/v3/mobile/verification-batches": {
      "post": {
        "operationId": "verifyMobileWrittenAnswers",
        "x-production-enabled": false,
        "x-required-draft-migration": "V3_020",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Explicit 3.1 manual/rubric request on the existing verification route. 3.0 remains objective-only. Every result binds its downloaded reference hash and test version. HTTP remains denied. Returns per-result outcomes; outer success=true does not imply every result succeeded. No result finalization or correction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WrittenBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect items: success/failed and retryable error. Includes stale reference, revision conflict, invalid evidence, score bounds and incomplete rubric outcomes.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing/expired session"
          },
          "403": {
            "description": "Release gate or teacher no longer owns all requested resources"
          },
          "409": {
            "description": "Immutable operation/sync identity conflict"
          },
          "413": {
            "description": "Body exceeds 2 MiB"
          },
          "422": {
            "description": "Invalid DTO, duplicate identities, unsupported kinds, missing actual response or invalid score precision"
          },
          "500": {
            "description": "Persistence acknowledgement unavailable; retry the same operation"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "VerificationResponse": {
        "type": "object",
