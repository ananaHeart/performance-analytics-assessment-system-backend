                  "replayed"
                ]
              },
              "acknowledgedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            },
            "required": [
              "resultUuid",
              "resultStatus",
              "revision",
              "scoreVersion",
              "replacementResultUuid",
              "disposition",
              "acknowledgedAt"
            ],
            "additionalProperties": false
