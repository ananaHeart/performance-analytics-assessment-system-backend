    "/api/v3/mobile/results/{resultUuid}/reopen": {
      "post": {
        "operationId": "reopenMobileResult",
        "x-production-enabled": false,
        "x-required-draft-migrations": [
          "V3_015",
          "V3_016",
          "V3_017",
          "V3_018",
          "V3_019",
          "V3_020",
          "V3_021"
        ],
        "description": "Reopen an owned Mobile result with a validated official finalization receipt. Required nonblank reasonCode is caller-supplied text, maximum 50 characters; comment is required as a field and may be null or at most 4000 characters. Expected revision and score version must match on a new operation. Commits audit, historical official snapshot, sync success and one revision advance atomically. Score version, old score and answers are preserved. Retry identical operation/sync UUIDs and content after timeout or 503; created/replayed acknowledgements are historical and current result state must be read separately. Maximum JSON body 32 KiB. Upload HTTP gate plus reopen flag remain disabled; first reopen also requires the finalization bridge flag.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "resultUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReopenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created or replayed historical acknowledgement. pending_verification retains the prior scoreVersion; replacementResultUuid is null.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleAck"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED"
          },
          "403": {
            "description": "RESULT_ACCESS_DENIED, or closed HTTP release gate"
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND: unknown or no-longer-owned result"
          },
          "409": {
            "description": "State/version/identity conflict; inspect the error, reconcile and use a new operation only for new intent. Never silently overwrite accepted history.",
            "x-error-codes": [
              "REVISION_CONFLICT",
              "RESULT_NOT_FINALIZED",
              "REOPEN_IDENTITY_CONFLICT",
              "SYNC_IDENTITY_CONFLICT",
              "OFFICIAL_SCORE_UNAVAILABLE",
              "FINALIZATION_STATE_CONFLICT",
              "REOPEN_STATE_CONFLICT",
              "RESULT_REVISION_EXHAUSTED",
              "ASSIGNMENT_ARCHIVED",
              "ASSESSMENT_NOT_SCORABLE"
            ]
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE above 32 KiB"
          },
          "422": {
            "description": "VALIDATION_FAILED: invalid fields, blank reason, invalid UUID/version, coercion, missing or unknown properties"
          },
          "503": {
            "description": "MOBILE_REOPEN_UNAVAILABLE or MOBILE_FINALIZATION_UNAVAILABLE release flags; REOPEN_PERSISTENCE_UNAVAILABLE permits identical-request retry after uncertain commit"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ReopenRequest": {
        "type": "object",
        "properties": {
          "contractVersion": {
            "const": "3.0"
          },
          "syncUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "operationUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expectedScoreVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "contractVersion",
          "syncUuid",
          "operationUuid",
          "expectedRevision",
          "expectedScoreVersion",
          "reasonCode",
          "comment"
        ],
        "additionalProperties": false
      },
