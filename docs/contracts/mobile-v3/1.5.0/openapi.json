{
  "openapi": "3.1.0",
  "info": {
    "title": "SMART Mobile V3 written scoring-reference",
    "version": "1.5.0",
    "description": "Prompt 10. Read route implemented; attachment/manual/rubric write schemas are review targets only."
  },
  "paths": {
    "/api/v3/mobile/test-assignments/{assignmentUuid}/evaluation-reference": {
      "get": {
        "operationId": "readMobileEvaluationReference",
        "x-production-enabled": false,
        "description": "Owned scoring-bounds snapshot. Disabled by default. No answer keys, accepted answers, model solutions, rubric descriptors or level definitions. Reference readiness does not enable written capture or score upload.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "assignmentUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consistent owned reference with SHA-256 fingerprint.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationReference"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Wrong role or inactive school teacher"
          },
          "404": {
            "description": "Unknown or foreign assignment"
          },
          "409": {
            "description": "EVALUATION_REFERENCE_NOT_READY, EVALUATION_REFERENCE_INVALID or EVALUATION_REFERENCE_LIMIT_EXCEEDED"
          },
          "422": {
            "description": "Noncanonical UUID"
          },
          "503": {
            "description": "EVALUATION_REFERENCE_UNAVAILABLE release gate"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "EvaluationReference": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "properties": {
              "contractVersion": {
                "const": "3.0"
              },
              "assignmentUuid": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "testVersionNumber": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "evaluationReferenceHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "questionUuid": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "maximumPoints": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 999999.99,
                      "multipleOf": 0.01
                    },
                    "rubricId": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "expectedResponseCount": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "questionUuid",
                    "maximumPoints",
                    "rubricId",
                    "expectedResponseCount"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 200
              },
              "rubrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rubricId": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "criteria": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rubricCriterionId": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "maximumPoints": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 999999.99,
                            "multipleOf": 0.01
                          },
                          "isRequired": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "rubricCriterionId",
                          "name",
                          "maximumPoints",
                          "isRequired"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 100
                    }
                  },
                  "required": [
                    "rubricId",
                    "name",
                    "criteria"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 200
              }
            },
            "required": [
              "contractVersion",
              "assignmentUuid",
              "testVersionNumber",
              "evaluationReferenceHash",
              "questions",
              "rubrics"
            ],
            "additionalProperties": false
          },
          "errors": {
            "type": "null"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "errors",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "AttachmentMetadata": {
        "type": "object",
        "properties": {
          "contractVersion": {
            "const": "3.0"
          },
          "syncUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "operationUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "attachmentUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "resultUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "scanPageUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "attachmentType": {
            "enum": [
              "normalized_page",
              "answer_crop",
              "teacher_evidence"
            ]
          },
          "regionUuid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceAttachmentUuid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "crop": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Crop"
              },
              {
                "type": "null"
              }
            ]
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fileSizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15728640
          },
          "mimeType": {
            "enum": [
              "image/jpeg",
              "image/png"
            ]
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "contractVersion",
          "syncUuid",
          "operationUuid",
          "attachmentUuid",
          "resultUuid",
          "scanPageUuid",
          "attachmentType",
          "regionUuid",
          "sourceAttachmentUuid",
          "crop",
          "contentHash",
          "fileSizeBytes",
          "mimeType",
          "capturedAt"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "attachmentType": {
                  "const": "normalized_page"
                }
              }
            },
            "then": {
              "properties": {
                "sourceAttachmentUuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "regionUuid": {
                  "type": "null"
                },
                "crop": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "sourceAttachmentUuid": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "attachmentType": {
                  "const": "answer_crop"
                }
              }
            },
            "then": {
              "properties": {
                "regionUuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "crop": {
                  "$ref": "#/components/schemas/Crop"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "attachmentType": {
                  "const": "teacher_evidence"
                }
              }
            },
            "then": {
              "properties": {
                "crop": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Crop": {
        "type": "object",
        "properties": {
          "baseAttachmentUuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "coordinateSpace": {
            "const": "image_pixels_top_left"
          },
          "baseWidthPx": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "baseHeightPx": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "baseAttachmentUuid",
          "coordinateSpace",
          "baseWidthPx",
          "baseHeightPx",
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "ManualEvaluation": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "manual"
          },
          "answerStatus": {
            "enum": [
              "answered",
              "blank"
            ]
          },
          "responseText": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "attachmentUuids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "points": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999.99,
            "multipleOf": 0.01
          }
        },
        "required": [
          "kind",
          "answerStatus",
          "responseText",
          "attachmentUuids",
          "points"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "answerStatus": {
                  "const": "blank"
                }
              }
            },
            "then": {
              "properties": {
                "points": {
                  "const": 0
                }
              }
            }
          }
        ]
      },
      "RubricEvaluation": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "rubric"
          },
          "answerStatus": {
            "enum": [
              "answered",
              "blank"
            ]
          },
          "responseText": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "attachmentUuids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "rubricId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "criterionScores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CriterionScore"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "kind",
          "answerStatus",
          "responseText",
          "attachmentUuids",
          "rubricId",
          "criterionScores"
        ],
        "additionalProperties": false
      },
      "CriterionScore": {
        "type": "object",
        "properties": {
          "rubricCriterionId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pointsAwarded": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999.99,
            "multipleOf": 0.01
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rubricCriterionId",
          "pointsAwarded",
          "comment"
        ],
        "additionalProperties": false
      }
    }
  }
}
