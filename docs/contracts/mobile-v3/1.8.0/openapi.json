    "/api/v3/scoring/results/{testResultId}/finalize": {
      "post": {
        "operationId": "finalizeMobileWrittenOrMixedResult",
        "x-production-enabled": false,
        "x-required-draft-migrations": [
          "V3_015",
          "V3_016",
          "V3_017",
          "V3_018",
          "V3_019",
          "V3_020"
        ],
        "description": "Existing bodyless first-finalization endpoint. For scan-backed results, validates accepted page/objective audits and written teacher scores, current public evaluation-reference binding, persisted rubric rows and retained evidence before existing backend scoring. No AI grading. Repeated successful finalization returns the immutable official snapshot with scoreChanged=false; it never rescores against later rubric edits. Requires current teacher ownership and the disabled-by-default Mobile finalization flag. No new migration in Prompt 13.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "testResultId",
            "in": "path",
            "required": true,
            "description": "Backend central result ID resolved from upload/readback mappings.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Official score with per-part totals. Initial commit advances result revision once; retry preserves scoreVersion and scoredAt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalizationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Teacher ownership or account access denied"
          },
          "404": {
            "description": "Unknown result, or SCAN_EVIDENCE_NOT_FOUND when required retained bytes are missing"
          },
          "409": {
            "description": "Incomplete capture/objective/written verification, changed reference, inconsistent accepted audit, invalid/missing answer key, or existing result needing audited reconciliation.",
            "x-error-codes": [
              "WRITTEN_VERIFICATION_INCOMPLETE",
              "WRITTEN_AUDIT_MISMATCH",
              "WRITTEN_REFERENCE_STALE",
              "SCAN_VERIFICATION_INCOMPLETE",
              "SCAN_EVIDENCE_INCOMPLETE",
              "OBJECTIVE_VERIFICATION_INCOMPLETE",
              "ANSWER_COVERAGE_INVALID",
              "ANSWER_KEY_INVALID",
              "ANSWER_KEY_MISSING",
              "FINALIZATION_STATE_CONFLICT",
              "AUDITED_REOPEN_REQUIRED",
              "RESULT_REVISION_EXHAUSTED"
            ]
          },
          "422": {
            "description": "ATTACHMENT_LINEAGE_INVALID: required evidence is purged, uncommitted or linked to an invalid base/region"
          },
          "500": {
            "description": "SCAN_EVIDENCE_INTEGRITY_FAILED: retained evidence bytes failed size/hash verification; official score is not committed"
          },
          "503": {
            "description": "MOBILE_FINALIZATION_UNAVAILABLE release gate"
          }
        }
      }
    }
  },
