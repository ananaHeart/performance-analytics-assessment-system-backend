{
  "openapi": "3.1.0",
  "info": {
    "title": "SMART Mobile V3 written and mixed result finalization",
    "version": "1.8.0",
    "description": "Prompt 13 behavioral supplement. Existing finalization/readback wire shapes remain unchanged from 1.0.0. Written verification requests use 3.1 from pack 1.7.0; no global wire-version bump."
  },
  "x-mobile-production-enabled": false,
  "paths": {
    "/api/v3/mobile/results/{resultUuid}": {
      "get": {
        "operationId": "readMobileResult",
        "x-production-enabled": false,
        "x-required-draft-migrations": [
          "V3_015",
          "V3_016",
          "V3_017",
          "V3_018",
          "V3_019",
          "V3_020"
        ],
        "description": "Owned repeatable-read snapshot. Disabled by default until persistence contracts are deployed. GET never finalizes, retries or mutates records. Metrics are server score totals only; advanced modules remain unavailable.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "resultUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current owned state, with explicit unavailable analytics and stage-scoped acknowledgements.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultReadback"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Wrong role or inactive school account"
          },
          "404": {
            "description": "Unknown or no-longer-owned resource; no existence disclosure"
          },
          "409": {
            "description": "READBACK_STATE_INCONSISTENT, READBACK_LIMIT_EXCEEDED or unsupported sync stage"
          },
          "422": {
            "description": "Noncanonical UUID"
          },
          "503": {
            "description": "MOBILE_READBACK_UNAVAILABLE release gate"
          }
        }
      }
    },
