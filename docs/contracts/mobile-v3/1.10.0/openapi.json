    "/api/v3/mobile/results/{resultUuid}/corrections": {
      "post": {
        "operationId": "correctAndFinalizeMobileResult",
        "x-production-enabled": false,
        "x-required-draft-migrations": [
          "V3_015",
          "V3_016",
          "V3_017",
          "V3_018",
          "V3_019",
          "V3_020",
          "V3_021",
          "V3_022"
        ],
        "description": "Submit a teacher review of every existing answer of the reopened result, including unchanged answers. Accepts corrections to objective options, written transcription, evidence selection, manual/rubric points and comments. The server computes objective points, validates current references and immutable capture, then commits answers, score version +1, revision +1, audit/history and successful sync receipt together. Any error rolls back the entire result. Retry the identical typed request with the same operation/sync/verification UUIDs; a replay returns the historical finalized response with scoreChanged=false. GET result/analytics for current state. This route does not accept replacement scans or staged partial corrections.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "resultUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Atomic finalized result; scoreChanged=true for a new correction, false for a committed historical retry. No second finalize request is required.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalizationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Wrong role or inactive school account"
          },
          "404": {
            "description": "Unknown or no-longer-owned resource; no existence disclosure"
          },
          "409": {
            "description": "Revision/reference/identity/state/capture/evidence conflict; whole result unchanged. Reconcile before creating new intent."
          },
          "422": {
            "description": "Invalid explicit 3.2 DTO, duplicate identities, invalid manual/rubric/option decision or incomplete review."
          },
          "503": {
            "description": "MOBILE_CORRECTION_UNAVAILABLE or dependent release gate; CORRECTION_PERSISTENCE_UNAVAILABLE requires identical retry because acknowledgement may be lost."
          },
          "413": {
            "description": "JSON body exceeds 2 MiB"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionRequest"
              }
            }
          }
        },
        "x-max-body-bytes": 2097152
      }
    }
  },
