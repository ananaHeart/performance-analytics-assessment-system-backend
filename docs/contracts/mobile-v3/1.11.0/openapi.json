              "contractVersion",
              "resultUuid",
              "testResultId",
              "assignmentUuid",
              "classListId",
              "studentId",
              "resultStatus",
              "revision",
              "scoreVersion",
              "pendingReasons",
              "idMappings",
              "pages",
              "rubricScoreMappings",
              "officialScore",
              "analytics"
