              },
              "resultStatus": {
                "enum": [
                  "pending_verification",
                  "superseded"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "scoreVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "replacementResultUuid": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "disposition": {
                "enum": [
                  "created",
                  "replayed"
                ]
              },
              "acknowledgedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            },
            "required": [
              "resultUuid",
              "resultStatus",
              "revision",
              "scoreVersion",
              "replacementResultUuid",
              "disposition",
              "acknowledgedAt"
            ],
            "additionalProperties": false
          },
          "errors": {
            "type": "null"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "errors",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "ResultReadback": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "properties": {
              "contractVersion": {
                "const": "3.0"
              },
              "resultUuid": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "testResultId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "assignmentUuid": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "classListId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "studentId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "resultStatus": {
                "enum": [
                  "draft",
                  "pending_verification",
                  "finalized",
                  "superseded"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "scoreVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pendingReasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "maxItems": 200
              },
              "idMappings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IdMapping"
                },
                "minItems": 0,
                "maxItems": 200
              },
              "pages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PageState"
                },
                "minItems": 0,
                "maxItems": 200
              },
              "rubricScoreMappings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RubricMapping"
                },
