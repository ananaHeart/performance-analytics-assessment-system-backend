    "/api/v3/mobile/results/{resultUuid}/supersede": {
      "post": {
        "operationId": "supersedeMobileResult",
        "x-production-enabled": false,
        "x-required-draft-migrations": [
          "V3_015",
          "V3_016",
          "V3_017",
          "V3_018",
          "V3_019",
          "V3_020",
          "V3_021",
          "V3_022",
          "V3_023"
        ],
        "description": "Link a finalized or audited reopened official source to a newer finalized result for the same delivery/student/current teacher. The replacement must be the latest non-superseded server-assigned attempt with distinct verified capture. Locks both; appends source/replacement official snapshots, audit, sync and immediate result/session lineage, marks source superseded and advances its revision only. Neither score version is recomputed. Existing latest-attempt report policy already selects one result before linkage; this endpoint records explicit supersession, not a retake grading policy. Replays return the original link even after a later chain link. Follow GET supersession and current result readback to resolve the chain.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "resultUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupersedeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immutable superseded acknowledgement, created or replayed; same 3.0 LifecycleAck.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleAck"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED"
          },
          "403": {
            "description": "RESULT_ACCESS_DENIED, or closed HTTP release gate"
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND: unknown or no-longer-owned result"
          },
          "409": {
            "description": "Source/replacement not official/current, different context, stale source revision/version, identity conflict, missing evidence or invalid receipt. Whole operation rolled back.",
            "x-error-codes": [
              "REVISION_CONFLICT",
              "RESULT_NOT_FINALIZED",
              "REOPEN_IDENTITY_CONFLICT",
              "SYNC_IDENTITY_CONFLICT",
              "OFFICIAL_SCORE_UNAVAILABLE",
              "FINALIZATION_STATE_CONFLICT",
              "REOPEN_STATE_CONFLICT",
              "RESULT_REVISION_EXHAUSTED",
              "ASSIGNMENT_ARCHIVED",
              "ASSESSMENT_NOT_SCORABLE"
            ]
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE above 32 KiB"
          },
          "422": {
            "description": "VALIDATION_FAILED: invalid fields, blank reason, invalid UUID/version, coercion, missing or unknown properties"
          },
          "503": {
            "description": "MOBILE_SUPERSEDE_UNAVAILABLE or SUPERSEDE_PERSISTENCE_UNAVAILABLE. Retry identical request after uncertain commit acknowledgement."
          }
        }
      }
    },
    "/api/v3/mobile/results/{resultUuid}/supersession": {
      "get": {
        "operationId": "readMobileSupersession",
        "x-production-enabled": false,
        "x-required-draft-migrations": [
          "V3_015",
          "V3_016",
          "V3_017",
          "V3_018",
          "V3_019",
          "V3_020",
          "V3_021",
          "V3_022",
          "V3_023"
        ],
        "description": "Read the durable immediate successor for this owned source. Reauthorizes both results. 404 SUPERSESSION_NOT_FOUND if no committed link exists. Follow each successor until its current result is not superseded; this is a read, never a relink or rescore.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "resultUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable superseded acknowledgement, created or replayed; same 3.0 LifecycleAck.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleAck"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED"
          },
          "403": {
            "description": "RESULT_ACCESS_DENIED, or closed HTTP release gate"
          },
          "404": {
            "description": "Owned result or committed link not found."
          },
          "409": {
            "description": "Source/replacement not official/current, different context, stale source revision/version, identity conflict, missing evidence or invalid receipt. Whole operation rolled back.",
            "x-error-codes": [
              "REVISION_CONFLICT",
              "RESULT_NOT_FINALIZED",
              "REOPEN_IDENTITY_CONFLICT",
              "SYNC_IDENTITY_CONFLICT",
              "OFFICIAL_SCORE_UNAVAILABLE",
              "FINALIZATION_STATE_CONFLICT",
              "REOPEN_STATE_CONFLICT",
              "RESULT_REVISION_EXHAUSTED",
              "ASSIGNMENT_ARCHIVED",
              "ASSESSMENT_NOT_SCORABLE"
            ]
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE above 32 KiB"
          },
          "422": {
            "description": "VALIDATION_FAILED: invalid fields, blank reason, invalid UUID/version, coercion, missing or unknown properties"
          },
          "503": {
            "description": "MOBILE_SUPERSEDE_UNAVAILABLE or SUPERSEDE_PERSISTENCE_UNAVAILABLE. Retry identical request after uncertain commit acknowledgement."
          }
        }
      }
    },
    "/api/v3/mobile/scan-pages": {
      "post": {
        "operationId": "uploadMobileScanPage",
        "x-production-enabled": false,
        "x-required-draft-migrations": [
          "V3_015",
          "V3_016",
          "V3_017",
          "V3_018",
          "V3_019",
          "V3_020",
          "V3_021",
          "V3_022",
          "V3_023"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Exactly one metadata JSON part and one image part. First captureNumber=1; rescan uses same result/scan/sheet/page identity, new syncUuid and scanPageUuid, captureNumber=current+1, at most 5 captures. Requires committed teacher rescan_requested decision and no accepted answers or previous official score. Atomically supersedes predecessor, links immutable page lineage, inserts new evidence/receipt and advances result revision. Preserves old evidence/detections/audits. Rescan uses existing one-page 10-MC A4 eligibility; paper/QR geometry is unchanged. Stage acknowledgement remains captured on historical replay. GET result/sync for current state.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "metadata": {
                    "$ref": "#/components/schemas/ScanMetadata"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "metadata",
                  "image"
                ],
                "additionalProperties": false
              },
              "encoding": {
                "metadata": {
                  "contentType": "application/json"
                },
                "image": {
                  "contentType": "image/jpeg, image/png"
                }
              }
            }
          }
        },
        "x-max-metadata-bytes": 65536,
        "x-max-captures-per-page": 5,
        "x-max-image-bytes": 15728640,
        "responses": {
          "201": {
            "description": "New capture committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "200": {
            "description": "Historical committed capture replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "403": {
            "description": "Teacher authorization or HTTP release gate"
          },
          "404": {
            "description": "Owned capture context not found"
          },
          "409": {
            "description": "Rescan predecessor/decision/context/number/identity or lifecycle conflict"
          },
          "413": {
            "description": "Upload bounds exceeded"
          },
          "422": {
            "description": "Invalid metadata or multipart content"
          },
          "500": {
            "description": "Uncertain persistence failure; retry identical upload or invoke backend recovery"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LifecycleAck": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
