# TEMPLATE ONLY. Do not put real credentials in this file or Git.
# Existing local .env/application-v3.properties remain unchanged.
# Render backend Dockerfile Path: Dockerfile.v3-cloud
# Health check: /api/v3/system/readiness
# Mount a permanent writable disk at /var/data before enabling this setup.
# This SMTP + disk route needs a suitable paid backend. Free-only needs separate
# object-storage/email-API implementation; do not deploy with temporary evidence storage.
# Review deploy/tidb-v3 first: current imported seven-check schema is NOT ready.
SPRING_PROFILES_ACTIVE=v3,v3-mobile-release,v3-cloud
V3_CLOUD_DB_USERNAME=REPLACE_IN_RENDER_SECRET_SETTINGS
V3_CLOUD_DB_PASSWORD=REPLACE_IN_RENDER_SECRET_SETTINGS
V3_CLOUD_PUBLIC_BASE_URL=https://REPLACE-BACKEND.onrender.com
V3_CLOUD_FRONTEND_ORIGIN=https://REPLACE-FRONTEND.onrender.com
V3_CLOUD_STORAGE_ROOT=/var/data
V3_CLOUD_EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
V3_CLOUD_SMTP_HOST=REPLACE_WITH_MAIL_PROVIDER_HOST
V3_CLOUD_SMTP_PORT=587
V3_CLOUD_SMTP_USERNAME=REPLACE_IN_RENDER_SECRET_SETTINGS
V3_CLOUD_SMTP_PASSWORD=REPLACE_IN_RENDER_SECRET_SETTINGS
# Generate a random 32-byte key and base64 encode it; retain it across deployments.
V3_CLOUD_MFA_ENCRYPTION_KEY=REPLACE_IN_RENDER_SECRET_SETTINGS
# Frontend Static Site setting (never place database/SMTP secrets in VITE variables):
# VITE_V3_API_URL=https://REPLACE-BACKEND.onrender.com
# Frontend build: npm ci && npm run build ; publish directory: dist
# Physical scanning and real-account end-to-end acceptance remain pending.
