# TEMPLATE ONLY. Do not put real credentials in this file or Git.
# Existing local .env/application-v3.properties remain unchanged.
# Render backend: New Web Service -> Docker, Dockerfile Path: Dockerfile.v3-cloud
# Health check path: /api/v3/system/readiness
#
# FREE-ONLY ROUTE (Render Free, testing):
# - Email goes through the Brevo HTTPS API (Render Free blocks outbound SMTP ports).
# - No persistent disk: V3_CLOUD_TEMPORARY_STORAGE=true keeps files in the container.
#   Answer-sheet PDFs and scan images are lost on every restart / 15-minute idle sleep;
#   accounts, classes, assessments and scores stay in TiDB.
# - With V3_CLOUD_TEMPORARY_STORAGE=true, sync keeps working after a wipe: finalization,
#   written scoring and corrections accept a missing file on its committed upload receipt
#   (a present-but-altered file still fails). A wiped answer-sheet PDF must be generated again
#   to download it; already printed sheets still scan.
# - The instance sleeps after 15 minutes idle; the first request then waits for startup.
#   For a demo/defense, keep it awake with a free pinger (e.g. cron-job.org) calling
#   /api/v3/system/ping every 10 minutes. Ping skips the database; /readiness runs the full
#   schema check and uses TiDB request units on every call. One always-on free service fits
#   in the 750 free instance hours per month.
SPRING_PROFILES_ACTIVE=v3,v3-mobile-release,v3-cloud
V3_CLOUD_DB_USERNAME=REPLACE_IN_RENDER_SECRET_SETTINGS
V3_CLOUD_DB_PASSWORD=REPLACE_IN_RENDER_SECRET_SETTINGS
V3_CLOUD_PUBLIC_BASE_URL=https://REPLACE-BACKEND.onrender.com
# Comma-separated; http://localhost:5173 lets you test the web app locally against this backend.
V3_CLOUD_FRONTEND_ORIGIN=https://REPLACE-FRONTEND.onrender.com,http://localhost:5173
V3_CLOUD_STORAGE_ROOT=/var/data
V3_CLOUD_TEMPORARY_STORAGE=true
V3_CLOUD_EMAIL_MODE=brevo-api
V3_CLOUD_BREVO_API_KEY=REPLACE_IN_RENDER_SECRET_SETTINGS
# Must be a sender address verified in your Brevo account.
V3_CLOUD_EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
# Generate a random 32-byte key and base64 encode it; keep the same key across deployments.
V3_CLOUD_MFA_ENCRYPTION_KEY=REPLACE_IN_RENDER_SECRET_SETTINGS
# Render Free has 512 MB RAM: keep the JVM small.
JAVA_TOOL_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC -Xss512k -XX:TieredStopAtLevel=1
#
# PAID ROUTE (only if a disk is ever added): mount it at /var/data, remove
# V3_CLOUD_TEMPORARY_STORAGE, and optionally V3_CLOUD_EMAIL_MODE=smtp with
# V3_CLOUD_SMTP_HOST / V3_CLOUD_SMTP_PORT / V3_CLOUD_SMTP_USERNAME / V3_CLOUD_SMTP_PASSWORD.
#
# Frontend Static Site setting (never place database or API secrets in VITE variables):
# VITE_V3_API_URL=https://REPLACE-BACKEND.onrender.com
# Frontend build: npm ci && npm run build ; publish directory: dist
# Physical scanning and real-account end-to-end acceptance remain pending.
